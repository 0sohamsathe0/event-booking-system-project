APP_ENV=production
APP_DEBUG=false
APP_SAFE_DIAGNOSTICS=false
APP_URL=https://example.vercel.app
APP_BASE_PATH=
APP_TIMEZONE=Asia/Kolkata

DB_HOST=mysql.example.invalid
DB_PORT=3306
DB_DATABASE=event_booking_system
DB_USERNAME=example_user
DB_PASSWORD=replace-with-a-secret
DB_CHARSET=utf8mb4
DB_SSL_MODE=required
DB_SSL_CA=

SESSION_DRIVER=database
SESSION_NAME=event_booking_session
SESSION_LIFETIME=7200

RAZORPAY_KEY_ID=rzp_test_example
RAZORPAY_KEY_SECRET=replace-with-a-test-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-a-webhook-secret

CLOUDINARY_CLOUD_NAME=example-cloud
CLOUDINARY_API_KEY=example-key
CLOUDINARY_API_SECRET=replace-with-a-secret
CLOUDINARY_FOLDER=event-booking-system/events
POSTER_STORAGE_DRIVER=cloudinary

LOG_CHANNEL=stderr
